; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Carbineball"
run/main_scene="uid://chrcvcmh2ejns"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://dlovvg7hm5ebs"

[audio]

buses/default_bus_layout="uid://7wvtt6rnphw5"

[autoload]

Music="*uid://c2sbpw7olcfgq"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/info/plugin.cfg", "res://addons/palette/plugin.cfg")

[file_customization]

folder_colors={
"res://Scenes/": "teal",
"res://Scripts/": "orange",
"res://Shaders/": "purple",
"res://Sounds/": "yellow",
"res://Sprites/": "red",
"res://_Starter/": "pink",
"res://_Starter/Scenes/": "green",
"res://_Starter/Scripts/": "orange",
"res://_Starter/Shaders/": "purple",
"res://_Starter/Sprites/": "red"
}

